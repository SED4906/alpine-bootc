# Contributor: SED4906 <sed4906birdie@gmail.com>
# Maintainer: SED4906 <sed4906birdie@gmail.com>
pkgname=bootc
pkgver=1.16.11
pkgrel=0
pkgdesc="Boot and upgrade via container images"
url="https://bootc.dev"
arch="x86_64 aarch64" # armv7 CI build ran out of memory
license="Apache-2.0 OR MIT"
depends="blkid dosfstools e2fsprogs findmnt fstrim lsblk mount podman sfdisk skopeo umount util-linux-misc wipefs"
makedepends="cargo-auditable rust zstd-dev ostree-dev go-md2man libselinux-dev clang-libclang"
source="https://github.com/bootc-dev/bootc/releases/download/v$pkgver/bootc-$pkgver.tar.zstd
https://github.com/bootc-dev/bootc/releases/download/v$pkgver/bootc-$pkgver-vendor.tar.zstd"
subpackages="
	$pkgname-base
	$pkgname-doc
	$pkgname-misc
	$pkgname-mkinitfs
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	"
options="!check" # test suite needs SELinux

unpack() {
	local u
	mkdir -p "$srcdir"
	for u in $source; do
		local s
		s="$SRCDEST/$(filename_from_uri $u)"
		msg "Unpacking $s..."
		tar -C "$srcdir" --zstd -xf "$s" || return 1
	done
	mv "$srcdir"/vendor "$srcdir"/bootc-$pkgver
}

prepare() {
	default_prepare
	mv .cargo/vendor-config.toml .cargo/config.toml
	cd crates/lib/src
	case $CARCH in
	x86_64|aarch64*) sed -i generator.rs -i install.rs -e 's/libc::.\+_MAGIC/& as u64/g' ;;
	arm*) sed -i generator.rs -i install.rs -e 's/libc::.\+_MAGIC/& as u32/g' ;;
	esac
}

build() {
	cargo auditable build --release --frozen -p bootc -p bootc-initramfs-setup
	cargo run --release --frozen -p xtask -- manpages
	mkdir -p target/completion
	for shell in bash fish zsh; do
		target/release/bootc completion $shell > target/completion/bootc.$shell
	done
}

package() {
	install -D -m 0755 -t "$pkgdir"/usr/bin target/release/bootc
	install -D -m 0755 target/release/bootc-initramfs-setup "$pkgdir"/usr/lib/bootc/initramfs-setup
	install -D -m 0644 -t "$pkgdir"/usr/share/man/man5 target/man/*.5
	install -D -m 0644 -t "$pkgdir"/usr/share/man/man8 target/man/*.8
	install -D -m 0644 target/completion/bootc.bash "$pkgdir"/usr/share/bash-completion/completions/bootc
	install -D -m 0644 target/completion/bootc.fish "$pkgdir"/usr/share/fish/vendor_completions.d/bootc.fish
	install -D -m 0644 target/completion/bootc.zsh "$pkgdir"/usr/share/zsh/site-functions/_bootc
}

base() {
	depends="$pkgname=$pkgver-r$pkgrel"
	pkgdesc="Base files for $pkgname"

	mkdir -p "$subpkgdir"/sysroot
	mkdir -p "$subpkgdir"/usr/lib/bootc/install
	mkdir -p "$subpkgdir"/usr/lib/ostree
	ln -s sysroot/ostree "$subpkgdir"/ostree
	echo '[composefs]' > "$subpkgdir"/usr/lib/ostree/prepare-root.conf
	echo 'enabled = false' >> "$subpkgdir"/usr/lib/ostree/prepare-root.conf
	echo '[install.filesystem.root]' > "$subpkgdir"/usr/lib/bootc/install/00-alpine.toml
	echo 'type = "ext4"' >> "$subpkgdir"/usr/lib/bootc/install/00-alpine.toml
}

misc() {
	depends="$pkgname=$pkgver-r$pkgrel"
	pkgdesc="Miscellaneous files for $pkgname"

	mkdir -p "$subpkgdir"/usr/bin
	cat <<- "EOF" > "$subpkgdir"/usr/bin/bootctl
	#!/bin/ash
	case $1$2$4 in
	install--root--esp-path)
	mkdir -p $3$5/EFI/Boot
	case $(arch) in
		x86_64) cp /usr/lib/systemd/boot/efi/systemd-bootx64.efi $3$5/EFI/Boot/BOOTX64.EFI ;;
		arm*) cp /usr/lib/systemd/boot/efi/systemd-bootarm.efi $3$5/EFI/Boot/BOOTARM.EFI ;;
		aarch64*) cp /usr/lib/systemd/boot/efi/systemd-bootaa64.efi $3$5/EFI/Boot/BOOTAA64.EFI ;;
		*) echo "Unsupported architecture!" ; exit 1 ;;
	esac
	mkdir -p $3$5/loader
	cat <<- "EOC" > $3$5/loader/loader.conf
	timeout 3
	console-mode max
	EOC
	;;
	*) echo "This is a stub bootctl." ; exit 1 ;;
	esac
	EOF
	chmod +x "$subpkgdir"/usr/bin/bootctl

	cat <<- "EOF" > "$subpkgdir"/usr/bin/systemctl
	#!/bin/ash
	case $1$2$3 in
	start--quietbootc-finalize-staged.service) bootc composefs-finalize-staged ;;
	*) echo "This is a stub systemctl." ; exit 1 ;;
	esac
	EOF
	chmod +x "$subpkgdir"/usr/bin/systemctl
}

mkinitfs() {
	depends="$pkgname=$pkgver-r$pkgrel mkinitfs"
	install_if="$pkgname=$pkgver-r$pkgrel mkinitfs"
	pkgdesc="$pkgname module for mkinitfs"

	mkdir -p "$subpkgdir"/etc/mkinitfs/features.d
	echo '/usr/lib/bootc/initramfs-setup' > "$subpkgdir"/etc/mkinitfs/features.d/bootc.files
	cat <<- "EOF" > "$subpkgdir"/etc/mkinitfs/features.d/bootc.modules
	kernel/fs/efivarfs
	kernel/fs/erofs
	EOF
}

